# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local model and voice assets: never commit large weights
models/**/*.gguf
models/**/*.onnx
models/**/*.bin
voice_packs/**
!voice_packs/README.md

# Local logs / temp
*.log
*.tmp
*.bak

# Pinned upstream source is fetched by CI/build scripts and is not vendored
third_party/llama.cpp/

# Local personal memory data (never commit user memories)
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Python caches and IDE project files
__pycache__/
*.py[cod]
*.iml
